# TDX attestation: the guest driver and configfs-tsm quotes
CONFIG_TDX_GUEST_DRIVER=y
CONFIG_CONFIGFS_FS=y

# Azure: network, disks, host integration services
CONFIG_HYPERV_NET=y
CONFIG_MICROSOFT_MANA=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_UTILS=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_HYPERV_MOUSE=y

# QEMU and other virtio hosts
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
