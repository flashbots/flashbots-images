# nftables + conntrack: connection-layer per-IP rate limiting
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_ACCOUNTING=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_DYNSET=y
CONFIG_NFT_META=y
CONFIG_NFT_PAYLOAD=y
CONFIG_NFT_SET_HASH=y
# Conntrack event netlink: lets the `conntrack` tool / exporters read live
# state for diagnostics
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_CONNTRACK_NETLINK=y
