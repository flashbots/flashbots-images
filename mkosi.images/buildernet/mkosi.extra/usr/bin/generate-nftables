#!/bin/bash
# builds and loads nftables ruleset from BuilderHub values.
# generated file is syntax-checked (nft -c) before loading.
# a bad ruleset is logged in full and not loaded.
set -uo pipefail

VALUES="${1:-/etc/nftables/nftables.env}"
OUT="${2:-/etc/nftables/ruleset.nft}"
log() { echo "nftables: $*"; }

[ -r "$VALUES" ] || { log "ERROR values file $VALUES missing"; exit 1; }

# parse the rendered env: four thresholds + one privileged "IP name" per line
conn_count_reg="" conn_count_priv="" rate_reg="" rate_priv=""
priv_elems=()
while IFS= read -r line; do
  case "$line" in
    total_conn_regular=*)           conn_count_reg="${line#*=}" ;;
    total_conn_privileged=*)        conn_count_priv="${line#*=}" ;;
    conn_rate_per_sec_regular=*)    rate_reg="${line#*=}" ;;
    conn_rate_per_sec_privileged=*) rate_priv="${line#*=}" ;;
    privileged_ip=*)
      entry="${line#*=}"
      ip="${entry%% *}"                       # field 1 = IP/CIDR
      name="${entry#"$ip"}"; name="${name# }" # rest = operator name
      cname="${name//\"/}"; [ -n "$cname" ] || cname="$ip"
      priv_elems+=("$ip comment \"$cname\"")
      ;;
  esac
done < "$VALUES"

# all thresholds must be present, else fail loud and load nothing
for v in conn_count_reg conn_count_priv rate_reg rate_priv; do
  [ -n "${!v}" ] || { log "ERROR missing required value: $v"; exit 1; }
done

# omit when empty since `elements = { }` is a syntax error
priv_line=""
if [ "${#priv_elems[@]}" -gt 0 ]; then
  joined="$(printf '%s, ' "${priv_elems[@]}")"; joined="${joined%, }"
  priv_line="        elements = { $joined }"
fi

# write the ruleset: privileged tier (high limits) accepted first, then regular
cat > "$OUT" <<EOF
#!/usr/sbin/nft -f
# generated by /usr/bin/generate-nftables from BuilderHub values; do not edit.

destroy table inet filter

table inet filter {
    set privileged_ips {
        type ipv4_addr
        flags interval
$priv_line
    }

    # per-source dynamic meters, one pair per tier. they fail OPEN when full
    # (add fails -> policy accept); accepted, haproxy L7 limits backstop.
    set conn_count_regular    { type ipv4_addr; size 131072; flags dynamic; }
    set conn_rate_regular     { type ipv4_addr; size 131072; flags dynamic; timeout 1m; }
    set conn_count_privileged { type ipv4_addr; size 131072; flags dynamic; }
    set conn_rate_privileged  { type ipv4_addr; size 131072; flags dynamic; timeout 1m; }

    # named counters so each drop is scrapable
    counter invalid_drop {}
    counter regular_conn_count_drop {}
    counter regular_conn_rate_drop {}
    counter privileged_conn_count_drop {}
    counter privileged_conn_rate_drop {}

    # only conntrack web traffic we rate-limit; p2p (reth/lighthouse) hits notrack.
    chain raw_prerouting {
        type filter hook prerouting priority raw; policy accept;
        tcp dport { 80, 443 } accept
        notrack
    }
    chain raw_output {
        type filter hook output priority raw; policy accept;
        tcp sport { 80, 443 } accept
        notrack
    }

    chain ingress {
        type filter hook input priority filter; policy accept;

        iif "lo" accept
        ct state established,related accept
        ct state invalid counter name "invalid_drop" drop

        meta l4proto != tcp accept
        tcp dport != { 80, 443 } accept

        # privileged tier (high thresholds), then accept
        ip saddr @privileged_ips ct state new add @conn_count_privileged { ip saddr ct count over $conn_count_priv } counter name "privileged_conn_count_drop" drop
        ip saddr @privileged_ips ct state new add @conn_rate_privileged { ip saddr limit rate over $rate_priv/second burst $rate_priv packets } counter name "privileged_conn_rate_drop" drop
        ip saddr @privileged_ips accept

        # regular tier
        ct state new add @conn_count_regular { ip saddr ct count over $conn_count_reg } counter name "regular_conn_count_drop" drop
        ct state new add @conn_rate_regular { ip saddr limit rate over $rate_reg/second burst $rate_reg packets } counter name "regular_conn_rate_drop" drop
    }
}
EOF

# validate, log the full error, load nothing on failure
if ! err="$(nft -c -f "$OUT" 2>&1)"; then
  log "ERROR generated ruleset failed validation, NOT loading:"
  printf '%s\n' "$err" | while IFS= read -r l; do log "  $l"; done
  exit 1
fi
nft -f "$OUT" || { log "ERROR failed to load validated ruleset $OUT"; exit 1; }
log "loaded $OUT (privileged: ${#priv_elems[@]} entries)"
