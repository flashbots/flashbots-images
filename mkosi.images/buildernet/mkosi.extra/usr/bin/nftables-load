#!/bin/bash
#
# usage: nftables-load [ruleset_file] [privileged_ips_list]

set -uo pipefail

RULESET="${1:-/etc/nftables/ruleset.nft}"
PRIV_LIST="${2:-/etc/nftables/privileged_ips.list}"

log() { echo "nftables-load: $*"; }

# base ruleset (atomic, essential)
if ! nft -f "$RULESET"; then
  log "failed to load base ruleset $RULESET"
  exit 1
fi
log "loaded base ruleset $RULESET"

# privileged IPs (best-effort). missing/empty list is fine
if [ ! -s "$PRIV_LIST" ]; then
  log "no privileged IPs to load ($PRIV_LIST missing or empty)"
  exit 0
fi

added=0
skipped=0
# field 1 is the IP/CIDR, rest of the line (operator name) is ignored.
# `|| [ -n "$ip" ]` catches a final line with no trailing newline
while read -r ip _ || [ -n "$ip" ]; do
  [ -n "$ip" ] || continue
  # IPv4/CIDR only, drop IPv6 and garbage before touching nft.
  if [[ ! "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?$ ]]; then
    log "skipping non-IPv4 privileged entry: $ip"
    skipped=$((skipped + 1))
    continue
  fi
  # add one at a time so a single rejected element (e.g. a /32 overlapping a
  # listed CIDR = "conflicting intervals", or a dupe) can't drop the rest
  if nft add element inet filter privileged_ips "{ $ip }" 2>/dev/null; then
    added=$((added + 1))
  else
    log "skipping privileged entry rejected by nft: $ip"
    skipped=$((skipped + 1))
  fi
done < "$PRIV_LIST"

log "privileged_ips: added $added, skipped $skipped"
exit 0
