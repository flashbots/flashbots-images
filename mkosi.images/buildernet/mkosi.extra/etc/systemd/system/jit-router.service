[Unit]
StartLimitIntervalSec=0
Description=jit-router - JIT-routing sidecar (JitRouter gRPC, asked per order by the builder)
Documentation=https://github.com/flashbots/jit-router/blob/main/README.md
Wants=network-online.target pamm-stream.service
After=network.target network-online.target rbuilder-operator.service pamm-stream.service jit-router-downloader.service
Requires=jit-router-downloader.service

[Service]
Type=exec
LimitNOFILE=65535
DynamicUser=yes
User=jit-router
EnvironmentFile=%E/jit-router/jit-router.env
ExecStart=/usr/bin/jit-router
TimeoutStartSec=5min
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=1min
RuntimeDirectory=jit-router
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes
# Decision rows go straight to ClickHouse (JIT_CH_*). A batch ClickHouse refuses is kept here and
# retried (JIT_CH_BACKUP_PATH, /var/lib/persistent/jit-router/clickhouse_backup.db), on the
# persistent disk as flowproxy's, so it survives a reboot.
StateDirectory=persistent/jit-router

[Install]
WantedBy=multi-user.target
