[Unit]
StartLimitIntervalSec=0
Description=jit-router - JIT-routing sidecar (JitRouter gRPC, asked per order by the builder)
Documentation=https://github.com/flashbots/jit-router/blob/main/README.md
Wants=network-online.target pamm-stream.service
After=network.target network-online.target rbuilder-operator.service pamm-stream.service jit-router-downloader.service
Requires=jit-router-downloader.service

[Service]
Type=exec
LimitNOFILE=65535
DynamicUser=yes
# Shared with jit-router-metrics, which tails and trims the decision journal in the runtime directory.
User=jit-router
EnvironmentFile=%E/jit-router/jit-router.env
ExecStart=/usr/bin/jit-router
TimeoutStartSec=5min
Restart=on-failure
RestartSec=5s
RestartSteps=5
RestartMaxDelaySec=1min
RuntimeDirectory=jit-router
RuntimeDirectoryMode=0711
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
