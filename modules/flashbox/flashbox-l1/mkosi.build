#!/usr/bin/env bash
set -euxo pipefail

source scripts/make_git_package.sh

# Build sync-proxy: receives Engine API calls mirrored from the external sync
# cluster and forwards them to the searcher's EL (see readme.md, "sync-proxy").
# TODO: switch to a release tag once the mirror-mode/metrics PRs are merged upstream.
SYNC_PROXY_REF="870715b"
make_git_package \
    "sync-proxy" \
    "$SYNC_PROXY_REF" \
    "https://github.com/flashbots/sync-proxy" \
    "go build -trimpath -ldflags \"-s -w -buildid= -X main.version=${SYNC_PROXY_REF}\" -o ./build/sync-proxy ." \
    "build/sync-proxy:/usr/bin/sync-proxy"
