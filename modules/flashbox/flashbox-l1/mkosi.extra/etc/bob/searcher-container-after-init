# This script is sourced from init-container.sh and contains image-specific stuff
# See also: bob-common/mkosi.extra/usr/bin/init-container.sh

# Searchers connect to the Flashbots and BuilderNet endpoints by hostname so
# TLS validates, but production mode has no DNS. egress-resolver renders
# /run/flashbox-endpoints/hosts on the host from the same validated addresses
# it installs in the firewall (BuilderNet names are resolved at runtime, the
# Flashbots Protect entries are static), and that directory is bind-mounted
# read-only into the container. Linking /etc/hosts to it means the container
# always sees the current file, including atomic replacements.
echo "Linking searcher container /etc/hosts to /run/flashbox-endpoints/hosts..."
exec_in_container 'ln -sfn /run/flashbox-endpoints/hosts /etc/hosts'
