# This script is sourced from firewall script and contains image-specific rules
# See also: bob-common/mkosi.extra/usr/bin/init-firewall.sh

# Image-specific ports
SSH_CONTROL_PORT=22
SSH_DATA_PORT=10022
SSH_REGISTER_PORT=8080
ATTESTED_TLS_PROXY_PORT=8745
SEARCHER_INPUT_UDP_PORT=27017
SEARCHER_INPUT_TCP_PORT=27018

# Well-known ports
DNS_PORT=53
DNS_OVER_TLS_PORT=853
HTTP_PORT=80
HTTPS_PORT=443
NTP_PORT=123
NTP_NTS_PORT=4460
CL_P2P_PORT=9000
EL_P2P_PORT=30303

# Flashbots bundle (always on)
FLASHBOTS_BUNDLE_1="18.221.59.61"
FLASHBOTS_BUNDLE_2="3.15.88.156"
# Flashbots tx stream (production only)
FLASHBOTS_TX_STREAM_1="3.136.107.142"
FLASHBOTS_TX_STREAM_2="3.149.14.12"

# BuilderNet endpoints (production only)
#
# BuilderNet serves BOTH the tx stream (persistent wss on path /bob) and bundle
# submission (bare path) over the same HTTPS endpoint, so the whole set is gated
# to production mode, unlike the always-on Flashbots bundle rule. Because the tx
# stream is an observable side channel, flows are torn down on toggle.
#
# Their addresses are NOT hardcoded: BuilderNet's contract with clients is the
# names rpc.buildernet.org and direct-{us,eu,ap}.buildernet.org, and the
# addresses behind them change. egress-resolver (a measured component, see
# /etc/bob/egress-resolver.toml and egress-resolver.service) resolves those
# names over DNS-over-TLS, requires DNSSEC-validated answers, rejects any
# non-global address and keeps two chains in sync, each holding one rule per
# address with a comment naming its source:
#   DYN_BNET_PRODUCTION_OUT   ACCEPT tcp/443 to the CURRENT addresses (PRODUCTION_OUT)
#   DYN_BNET_MAINTENANCE_OUT  DROP everything ever resolved since boot (MAINTENANCE_OUT)
# The chains are created empty here and jumped to from static rules, so
# `iptables-save` remains the complete description of the policy; only the
# contents of these two chains vary at runtime. The same addresses are written
# to the container's /etc/hosts, so the container cannot learn an address the
# firewall does not allow.
CHAIN_DYN_BNET_PRODUCTION_OUT="DYN_BNET_PRODUCTION_OUT"
CHAIN_DYN_BNET_MAINTENANCE_OUT="DYN_BNET_MAINTENANCE_OUT"
iptables -N $CHAIN_DYN_BNET_PRODUCTION_OUT
iptables -N $CHAIN_DYN_BNET_MAINTENANCE_OUT

# egress-resolver runs its DNS step as this uid and may only reach the
# resolvers configured in /etc/bob/egress-resolver.toml on 853. The list is
# read from that file (single source of truth); the config is validated at
# image build time (mkosi.postinst) so this cannot fail at boot.
EGRESS_RESOLVER_USER="egress-resolver"
EGRESS_RESOLVER_DNS="$(/usr/bin/egress-resolver print-servers --config /etc/bob/egress-resolver.toml)"

# The rootless container's network (pasta) runs on the host as this uid.
SEARCHER_USER="searcher"

# Prometheus metrics proxy
PROMETHEUS_PROXY_IP="10.88.0.100"

###########################################################################
# (1) ALWAYS_IN: Inbound rules that are always applied
###########################################################################

accept_dst_port $CHAIN_ALWAYS_IN tcp $SSH_CONTROL_PORT "SSH control port"
accept_dst_port $CHAIN_ALWAYS_IN udp $SEARCHER_INPUT_UDP_PORT "Searcher UDP input channel"
accept_dst_port $CHAIN_ALWAYS_IN tcp $SEARCHER_INPUT_TCP_PORT "Searcher TCP input channel (input-only-proxy)"

# attested-tls-proxy serves server attestation
# Also forwards request to ssh pubkey server on localhost:5001,
#    which serves searcher-container openssh server pubkey
accept_dst_port $CHAIN_ALWAYS_IN tcp $ATTESTED_TLS_PROXY_PORT "attested-tls-proxy"

# Note: this is CL running on the host
accept_dst_port $CHAIN_ALWAYS_IN tcp $CL_P2P_PORT "CL P2P (TCP)"
accept_dst_port $CHAIN_ALWAYS_IN udp $CL_P2P_PORT "CL P2P (UDP)"

###########################################################################
# (2) ALWAYS_OUT: Outbound rules that are always applied
###########################################################################

# egress-resolver: the only DNS path that exists in production mode. Only its
# uid may open TCP/853 to the pinned resolvers, and nothing else from that uid
# leaves the host. These two rules MUST stay first in ALWAYS_OUT: the accepts
# below are not uid-scoped and would otherwise apply to this uid as well.
iptables -A $CHAIN_ALWAYS_OUT -p tcp -d $EGRESS_RESOLVER_DNS --dport $DNS_OVER_TLS_PORT \
    -m owner --uid-owner $EGRESS_RESOLVER_USER -m conntrack --ctstate NEW -j ACCEPT \
    -m comment --comment "egress-resolver DNS-over-TLS"
iptables -A $CHAIN_ALWAYS_OUT -m owner --uid-owner $EGRESS_RESOLVER_USER \
    -m conntrack --ctstate NEW -j DROP \
    -m comment --comment "egress-resolver: no other egress"

# Note: this is CL running on the host, searcher netns has DROP on those
# See also init-container.sh
accept_dst_port $CHAIN_ALWAYS_OUT tcp $CL_P2P_PORT "CL P2P (TCP)"
accept_dst_port $CHAIN_ALWAYS_OUT udp $CL_P2P_PORT "CL P2P (UDP)"

# Note: this is accessible only from host, searcher netns has DROP on those
accept_dst_port $CHAIN_ALWAYS_OUT udp $NTP_PORT "NTP"
accept_dst_port $CHAIN_ALWAYS_OUT tcp $NTP_NTS_PORT "NTP-NTS"

# Flashbots bundle endpoints (always on)
# Security note: This is a side channel.
# While the operator will not be able to see the content of the packets,
# they can observe the presence or absence of packets.
accept_dst_ip_port $CHAIN_ALWAYS_OUT tcp $FLASHBOTS_BUNDLE_1,$FLASHBOTS_BUNDLE_2 $HTTPS_PORT "Flashbots bundle"

# Prometheus metrics proxy (searcher netns has a DROP on this IP — see init-container.sh)
accept_dst_ip_port $CHAIN_ALWAYS_OUT tcp $PROMETHEUS_PROXY_IP $HTTPS_PORT "Prometheus metrics proxy"

###########################################################################
# (3) MAINTENANCE_IN: Inbound rules for Maintenance Mode
###########################################################################

accept_dst_port $CHAIN_MAINTENANCE_IN tcp $SSH_DATA_PORT "SSH data plane"
accept_dst_port $CHAIN_MAINTENANCE_IN tcp $SSH_REGISTER_PORT "SSH register service"

accept_dst_port $CHAIN_MAINTENANCE_IN tcp $EL_P2P_PORT "EL P2P (TCP)"
accept_dst_port $CHAIN_MAINTENANCE_IN udp $EL_P2P_PORT "EL P2P (UDP)"

###########################################################################
# (4) MAINTENANCE_OUT: Outbound rules for Maintenance Mode
###########################################################################

# Block Flashbots protect tx endpoints during maintenance
drop_dst_ip $CHAIN_MAINTENANCE_OUT $FLASHBOTS_TX_STREAM_1,$FLASHBOTS_TX_STREAM_2 "Flashbots Protect (DROP before accept-all rules)"

# Block BuilderNet endpoints during maintenance: every address egress-resolver
# has seen since boot (the chain only grows while the box is up).
iptables -A $CHAIN_MAINTENANCE_OUT -j $CHAIN_DYN_BNET_MAINTENANCE_OUT \
    -m comment --comment "BuilderNet (runtime-populated DROP list, before accept-all rules)"

accept_dst_port $CHAIN_MAINTENANCE_OUT udp $DNS_PORT "DNS (UDP)"
accept_dst_port $CHAIN_MAINTENANCE_OUT tcp $DNS_PORT "DNS (TCP)"
accept_dst_port $CHAIN_MAINTENANCE_OUT tcp $DNS_OVER_TLS_PORT "DNS-over-TLS"

accept_dst_port $CHAIN_MAINTENANCE_OUT tcp $HTTP_PORT "HTTP"
accept_dst_port $CHAIN_MAINTENANCE_OUT tcp $HTTPS_PORT "HTTPS"

accept_dst_port $CHAIN_MAINTENANCE_OUT tcp $EL_P2P_PORT "EL P2P (TCP)"
accept_dst_port $CHAIN_MAINTENANCE_OUT udp $EL_P2P_PORT "EL P2P (UDP)"

###########################################################################
# (5) PRODUCTION_IN: Inbound rules for Production Mode
###########################################################################

# None at the moment

###########################################################################
# (6) PRODUCTION_OUT: Outbound rules for Production Mode
###########################################################################

# The searcher container has no DNS in production. Its queries reach the host
# only through pasta (uid searcher) forwarding to systemd-resolved's stub on
# loopback; upstream is already unreachable in this mode, but the stub would
# still answer from its cache. Drop that path so not even cached names resolve.
# (Evaluated before OUTPUT's loopback accept; kill_maintenance_connections
# removes existing udp/tcp 53 conntrack state on toggle.)
iptables -A $CHAIN_PRODUCTION_OUT -o lo -p udp --dport $DNS_PORT \
    -m owner --uid-owner $SEARCHER_USER -j DROP \
    -m comment --comment "searcher DNS to host stub (no DNS in production)"
iptables -A $CHAIN_PRODUCTION_OUT -o lo -p tcp --dport $DNS_PORT \
    -m owner --uid-owner $SEARCHER_USER -j DROP \
    -m comment --comment "searcher DNS to host stub (no DNS in production)"

accept_dst_ip_port $CHAIN_PRODUCTION_OUT tcp $FLASHBOTS_TX_STREAM_1,$FLASHBOTS_TX_STREAM_2 $HTTPS_PORT "Flashbots Protect tx stream"

# BuilderNet tx stream (path /bob) + bundle submission (bare path), same HTTPS
# endpoint: tcp/443 to the addresses egress-resolver currently has for the names.
iptables -A $CHAIN_PRODUCTION_OUT -j $CHAIN_DYN_BNET_PRODUCTION_OUT \
    -m comment --comment "BuilderNet tx stream + bundle submission (runtime-populated)"
