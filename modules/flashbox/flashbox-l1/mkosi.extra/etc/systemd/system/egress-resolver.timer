[Unit]
Description=Periodic BuilderNet endpoint refresh

[Timer]
# The first run happens at boot (egress-resolver-apply.service is wanted by
# minimal.target and by the container unit); afterwards refresh one minute
# after each completed run. Starting the apply unit pulls in the resolve unit.
OnBootSec=60s
OnUnitInactiveSec=60s
AccuracySec=5s
Unit=egress-resolver-apply.service

[Install]
WantedBy=minimal.target
