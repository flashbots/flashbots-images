#!/bin/bash
set -e

# Log directory: written by systemd (StandardOutput=append: in
# sync-proxy.service), rotated by logrotate, and bind-mounted read-only into the
# searcher container at /var/log/sync-proxy so searchers can tail whether engine
# calls arrive. Runs as its own oneshot unit because systemd opens the
# StandardOutput file before any Exec* of sync-proxy.service runs.
mkdir -p /persistent/sync_proxy_logs
chmod 755 /persistent/sync_proxy_logs
