#!/usr/bin/env bash
set -euxo pipefail

source scripts/make_git_package.sh

mkdir -p "$DESTDIR/usr/bin"
mkosi-chroot rustc --edition 2021 -O -C strip=debuginfo -C link-arg=-Wl,--build-id=none \
    --remap-path-prefix "$SRCDIR=/src" \
    -o "$DESTDIR/usr/bin/sandbox-pool" "$SRCDIR/modules/flashbox/flashbox-stateless/sandbox-pool.rs"

make_git_package \
    "cryptsetup" \
    "v2.8.1" \
    "https://gitlab.com/cryptsetup/cryptsetup" \
    './autogen.sh && ./configure --with-crypto_backend=kernel --disable-veritysetup --disable-integritysetup --disable-asciidoc && make -j$(nproc)' \
    ".libs/cryptsetup:/usr/sbin/cryptsetup" \
    ".libs/libcryptsetup.so.12.11.0:/usr/lib/x86_64-linux-gnu/libcryptsetup.so.12"

make_git_package \
    "tdx-init" \
    "v0.3.2" \
    "https://github.com/flashbots/tdx-init" \
    'go build -trimpath -ldflags "-s -w -buildid=" -o ./build/tdx-init' \
    "build/tdx-init:/usr/bin/tdx-init"

make_git_package \
    "ssh-pubkey-server" \
    "v0.1.0" \
    "https://github.com/flashbots/ssh-pubkey-server" \
    'go build -trimpath -ldflags "-s -w -buildid= -X github.com/flashbots/go-template/common.Version=v1.0.0" -o ./build/ssh-pubkey-server cmd/httpserver/main.go' \
    "build/ssh-pubkey-server:/usr/bin/ssh-pubkey-server"

VERSION="v2.0.4"
EXPECTED_SHA256=0c50b2e00de14972d415bf4aa358e3917480f1e86e1981a70a4055115c13a21e
curl -sSfL https://github.com/flashbots/attested-tls-proxy/releases/download/${VERSION}/attested-tls-proxy_1.${VERSION}_amd64.deb \
  -o $PACKAGEDIR/attested-tls-proxy.deb
echo "${EXPECTED_SHA256}" $PACKAGEDIR/attested-tls-proxy.deb | sha256sum --check
