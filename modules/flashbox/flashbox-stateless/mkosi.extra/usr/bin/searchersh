#!/bin/sh
set -eu
case "${1:-}:${2:-}" in
    -c:initialize) sudo tdx-init set-passphrase && chmod 2775 /persistent/searcher && mkdir -m 2775 -p /persistent/searcher/data && sudo systemctl start flashbox-data ;;
    -c:upload) cat > /persistent/searcher/.flashbox.tar && mv /persistent/searcher/.flashbox.tar /persistent/searcher/flashbox.tar ;;
    -c:deploy)
        systemctl -q is-active sandbox-relay && { echo "stop first" >&2; exit 1; }
        exec sudo systemctl restart flashbox-deploy ;;
    -c:start)  exec sudo systemctl start sandbox-relay ;;
    -c:stop)   exec sudo systemctl stop sandbox-relay ;;
    -c:status) systemctl -q is-active sandbox-relay && echo running || echo stopped ;;
    *) printf 'commands: initialize upload deploy start stop status\nconnect to db with: ssh -N -L 6379:127.0.0.1:6379 <ip>\n' >&2; exit 1 ;;
esac
