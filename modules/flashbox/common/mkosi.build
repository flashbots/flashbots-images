#!/usr/bin/env bash
set -euxo pipefail

source scripts/make_git_package.sh
source scripts/build_rust_package.sh

# Compile searchersh
mkdir -p "$DESTDIR/usr/bin"
mkosi-chroot gcc -o "$DESTDIR/usr/bin/searchersh" "$SRCDIR/modules/flashbox/common/searchersh.c"
chmod 755 "$DESTDIR/usr/bin/searchersh"

# Compile cryptsetup
make_git_package \
    "cryptsetup" \
    "v2.8.8" \
    "https://gitlab.com/cryptsetup/cryptsetup" \
    './autogen.sh && ./configure --with-crypto_backend=kernel --disable-veritysetup --disable-integritysetup --disable-asciidoc && make -j$(nproc)' \
    ".libs/cryptsetup:/usr/sbin/cryptsetup" \
    ".libs/libcryptsetup.so.12.11.0:/usr/lib/x86_64-linux-gnu/libcryptsetup.so.12"

# Build delay-pipe
build_rust_package \
    "delay-pipe" \
    "v0.0.3" \
    "https://github.com/flashbots/delay-pipe"

# Build tdx-init
make_git_package \
    "tdx-init" \
    "v0.3.3" \
    "https://github.com/flashbots/tdx-init" \
    'go build -trimpath -ldflags "-s -w -buildid=" -o ./build/tdx-init' \
    "build/tdx-init:/usr/bin/tdx-init"

# Build ssh-pubkey-server
make_git_package \
    "ssh-pubkey-server" \
    "v0.1.1" \
    "https://github.com/flashbots/ssh-pubkey-server" \
    'go build -trimpath -ldflags "-s -w -buildid= -X github.com/flashbots/go-template/common.Version=v1.0.0" -o ./build/ssh-pubkey-server cmd/httpserver/main.go' \
    "build/ssh-pubkey-server:/usr/bin/ssh-pubkey-server"


# Install the proxy and quote provider from the same release.
ATTESTED_TLS_VERSION="v2.0.8"

download_attested_tls_deb() {
    local package="$1" expected_sha256="$2"
    local deb="$PACKAGEDIR/$package.deb"

    curl -sSfL "https://github.com/flashbots/attested-tls-proxy/releases/download/${ATTESTED_TLS_VERSION}/${package}_1.${ATTESTED_TLS_VERSION}_amd64.deb" \
        -o "$deb"
    printf '%s  %s\n' "$expected_sha256" "$deb" | sha256sum --check
}

download_attested_tls_deb attested-tls-proxy b3b0f82d1b8dce3d2ff87a59e492e77efcbfe43a6dc081d867fa70161019cbce
download_attested_tls_deb attestation-provider-server d47875590ea54b0e61892f1b789514050c27e1fbddb126e389cb74e864c0f5ff

# Build input-only-proxy
build_rust_package \
    "input-only-proxy" \
    "v0.0.3" \
    "https://github.com/flashbots/input-only-proxy"
