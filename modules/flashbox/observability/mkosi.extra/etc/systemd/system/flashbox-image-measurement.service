[Unit]
Description=Flashbox image measurement metric
Before=node-exporter.service

# Only TDX guests have a CCEL
ConditionPathExists=/sys/firmware/acpi/tables/data/CCEL

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=flashbox/metrics
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/flashbox-image-measurement
StandardOutput=truncate:/run/flashbox/metrics/image-measurement.prom

[Install]
WantedBy=minimal.target
